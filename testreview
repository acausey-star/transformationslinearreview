        let playerName = "";
        let currentQuestionIndex = 0;
        let score = 0;
        let streak = 0;
        let maxStreak = 0;
        let correctCount = 0;
        let missedQuestions = [];
        let answeredCurrent = false;

        function safeConfetti(options) {
            try {
                if (typeof confetti === 'function') {
                    confetti(options);
                }
            } catch (e) {
                // Fails silently if offline or blocked by school firewalls
            }
        }

        function startGame() {
            const input = document.getElementById("player-name");
            playerName = input.value.trim() || "Challenger";
            
            document.getElementById("screen-welcome").classList.add("hidden");
            document.getElementById("screen-quiz").classList.remove("hidden");
            document.getElementById("stats-bar").classList.remove("hidden");
            
            currentQuestionIndex = 0;
            score = 0;
            streak = 0;
            maxStreak = 0;
            correctCount = 0;
            missedQuestions = [];

            loadQuestion();
        }

        function loadQuestion() {
            answeredCurrent = false;
            const q = questions[currentQuestionIndex];
            
            document.getElementById("current-q-num").innerText = currentQuestionIndex + 1;
            document.getElementById("progress-bar").style.width = `${((currentQuestionIndex + 1) / questions.length) * 100}%`;
            document.getElementById("question-tag").innerText = q.tag;
            document.getElementById("question-text").innerText = q.question;
            
            document.getElementById("feedback-box").classList.add("hidden");
            document.getElementById("btn-next").classList.add("hidden");

            const optionsContainer = document.getElementById("options-container");
            optionsContainer.innerHTML = "";

            q.options.forEach((opt, idx) => {
                const btn = document.createElement("button");
                btn.className = "w-full text-left bg-slate-700/60 hover:bg-slate-700 border border-slate-600 rounded-xl p-4 text-white transition font-medium flex justify-between items-center group";
                
                const spanText = document.createElement("span");
                spanText.textContent = opt.text;
                
                const spanArrow = document.createElement("span");
                spanArrow.className = "text-xs text-slate-400 group-hover:text-white";
                spanArrow.textContent = "Select ➔";

                btn.appendChild(spanText);
                btn.appendChild(spanArrow);

                btn.onclick = () => selectOption(idx, btn);
                optionsContainer.appendChild(btn);
            });
        }

        function selectOption(selectedIndex, selectedBtn) {
            if (answeredCurrent) return;
            answeredCurrent = true;

            const q = questions[currentQuestionIndex];
            const allButtons = document.getElementById("options-container").children;
            
            q.options.forEach((opt, idx) => {
                const btn = allButtons[idx];
                btn.disabled = true;
                if (opt.isCorrect) {
                    btn.className = "w-full text-left bg-emerald-900/50 border border-emerald-500 rounded-xl p-4 text-emerald-200 font-medium flex justify-between items-center";
                } else if (idx === selectedIndex) {
                    btn.className = "w-full text-left bg-rose-900/50 border border-rose-500 rounded-xl p-4 text-rose-200 font-medium flex justify-between items-center";
                } else {
                    btn.className = "w-full text-left bg-slate-800 border border-slate-700 rounded-xl p-4 text-slate-500 font-medium flex justify-between items-center opacity-50";
                }
            });

            const isCorrect = q.options[selectedIndex].isCorrect;
            const feedbackBox = document.getElementById("feedback-box");
            const feedbackTitle = document.getElementById("feedback-title");
            const feedbackRationale = document.getElementById("feedback-rationale");

            feedbackBox.classList.remove("hidden");

            if (isCorrect) {
                correctCount++;
                streak++;
                if (streak > maxStreak) maxStreak = streak;
                const points = 100 + (streak * 15);
                score += points;

                feedbackBox.className = "mb-6 p-4 rounded-xl border border-emerald-500/50 bg-emerald-950/40 text-sm";
                feedbackTitle.className = "font-bold text-emerald-400 mb-1";
                feedbackTitle.innerText = `Correct! (+${points} pts)`;
                feedbackRationale.innerText = q.options[selectedIndex].rationale;

                if (currentQuestionIndex === questions.length - 1) {
                    safeConfetti({ particleCount: 150, spread: 90, origin: { y: 0.6 } });
                }
            } else {
                streak = 0;
                missedQuestions.push({
                    question: q.question,
                    userAnswer: q.options[selectedIndex].text,
                    correctAnswer: q.options.find(o => o.isCorrect).text,
                    rationale: q.options[selectedIndex].rationale
                });

                feedbackBox.className = "mb-6 p-4 rounded-xl border border-rose-500/50 bg-rose-950/40 text-sm";
                feedbackTitle.className = "font-bold text-rose-400 mb-1";
                feedbackTitle.innerText = "Incorrect";
                feedbackRationale.innerText = q.options[selectedIndex].rationale;
            }

            document.getElementById("current-score").innerText = score;
            document.getElementById("current-streak").innerText = `🔥 ${streak}`;
            document.getElementById("btn-next").classList.remove("hidden");
        }

        function nextQuestion() {
            currentQuestionIndex++;
            if (currentQuestionIndex < questions.length) {
                loadQuestion();
            } else {
                endGame();
            }
        }

        function endGame() {
            document.getElementById("screen-quiz").classList.add("hidden");
            document.getElementById("stats-bar").classList.add("hidden");
            document.getElementById("screen-gameover").classList.remove("hidden");

            document.getElementById("final-player-name").innerText = `Great battle, ${playerName}!`;
            document.getElementById("final-score").innerText = `${score} pts`;
            document.getElementById("final-correct").innerText = correctCount;
            document.getElementById("final-streak").innerText = maxStreak;

            const reviewBtn = document.getElementById("btn-review");
            if (missedQuestions.length > 0) {
                reviewBtn.classList.remove("hidden");
            } else {
                reviewBtn.classList.add("hidden");
            }

            if (correctCount >= 15) {
                safeConfetti({ particleCount: 200, spread: 120, origin: { y: 0.5 } });
            }
        }

        function reviewMistakes() {
            document.getElementById("screen-gameover").classList.add("hidden");
            document.getElementById("screen-review").classList.remove("hidden");

            const reviewList = document.getElementById("review-list");
            reviewList.innerHTML = "";

            missedQuestions.forEach((item, idx) => {
                const card = document.createElement("div");
                card.className = "bg-slate-900 border border-slate-700 rounded-xl p-4 text-sm";
                card.innerHTML = `
                    <div class="font-semibold text-white mb-2">Q${idx + 1}: ${item.question}</div>
                    <div class="text-rose-400 mb-1">Your Answer: ${item.userAnswer}</div>
                    <div class="text-emerald-400 mb-2">Correct Answer: ${item.correctAnswer}</div>
                    <div class="text-slate-400 text-xs italic">Why: ${item.rationale}</div>
                `;
                reviewList.appendChild(card);
            });
        }

        function backToGameOver() {
            document.getElementById("screen-review").classList.add("hidden");
            document.getElementById("screen-gameover").classList.remove("hidden");
        }

        function resetGame() {
            document.getElementById("screen-gameover").classList.add("hidden");
            document.getElementById("screen-welcome").classList.remove("hidden");
            document.getElementById("player-name").value = "";
        }
    </script>
</body>
</html>
