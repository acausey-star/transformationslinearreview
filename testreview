            },
            {
                tag: "Domain & Range (TEKS A.2A)",
                question: "What is the domain of the linear function f(x) = -2x + 6 if the range is given as {-2 <= y <= 10}?",
                options: [
                    { text: "{-2 <= x <= 4}", isCorrect: true, rationale: "Set y equal to boundaries: -2 = -2x + 6 gives x = 4, and 10 = -2x + 6 gives x = -2. Thus, domain is -2 <= x <= 4." },
                    { text: "{-2 <= y <= 10}", isCorrect: false, rationale: "This restates the range instead of finding the domain." },
                    { text: "{0 <= x <= 3}", isCorrect: false, rationale: "An arithmetic calculation error was made when solving for x." },
