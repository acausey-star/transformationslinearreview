                question: "A calculator computes a linear regression model with a correlation coefficient of r = -0.95. Which statement is true about the data?",
                options: [
                    { text: "There is a strong downward trend where as one variable increases, the other decreases.", isCorrect: true, rationale: "A negative r close to -1 indicates a strong inverse relationship." },
                    { text: "The relationship between the variables is perfectly non-linear.", isCorrect: false, rationale: "The high absolute value of r indicates a strong linear model fit." },
                    { text: "There is a strong positive correlation between the variables.", isCorrect: false, rationale: "A negative r value denotes a negative (downward) correlation, not positive." },
