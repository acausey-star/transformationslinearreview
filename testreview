                ],
                hint: "A negative coefficient means variables move in opposite directions with high strength."
            },
            {
                tag: "Domain & Range (TEKS A.2A)",
                question: "A car's fuel tank holds 14 gallons and consumes 0.05 gallons per mile driven. The car is driven until the tank is empty at 280 miles. What is a reasonable domain for the function modeling gallons remaining?",
                options: [
                    { text: "0 <= x <= 280", isCorrect: true, rationale: "The domain represents miles driven (x), which starts at 0 miles and ends when the tank is empty at 280 miles." },
                    { text: "0 <= y <= 14", isCorrect: false, rationale: "0 <= y <= 14 represents the reasonable range (gallons remaining), not the domain." },
